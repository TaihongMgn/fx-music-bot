FROM python:3.11-slim-bookworm AS python-builder
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /botamusique
RUN apt-get update \
    && apt-get install --no-install-recommends -y gcc g++ ffmpeg libjpeg-dev libmagic-dev opus-tools zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
COPY . /botamusique
RUN python3 -m venv venv \
    && venv/bin/pip install wheel \
    && venv/bin/pip install -r requirements.txt


FROM node:20-bookworm-slim AS node-builder
ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_OPTIONS=--openssl-legacy-provider
WORKDIR /botamusique/web
COPY web /botamusique/web
RUN npm install
RUN npm run build


FROM python:3.11-slim-bookworm AS template-builder
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /botamusique
COPY --from=python-builder /botamusique .
COPY --from=node-builder /botamusique/web/templates web/templates
COPY --from=node-builder /botamusique/static static
RUN venv/bin/python scripts/translate_templates.py --lang-dir /botamusique/lang --template-dir /botamusique/web/templates


FROM node:20-bookworm-slim AS netease-api-builder
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /netease-api
COPY netease-api /netease-api
RUN npm install --production --ignore-scripts \
    && rm -rf /root/.npm /tmp/*


FROM python:3.11-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive
EXPOSE 8181 3000
WORKDIR /botamusique
RUN apt-get update \
    && apt-get install --no-install-recommends -y opus-tools ffmpeg libmagic-dev curl tar zlib1g \
       ca-certificates supervisor libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log/supervisor /etc/supervisor/conf.d
# Debian 11 and NodeSource Node 16 are both gone. Reuse the Node 20 binary from the API stage.
COPY --from=netease-api-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=python-builder /botamusique .
COPY --from=template-builder /botamusique/static static
COPY --from=template-builder /botamusique/web/templates web/templates
COPY --from=netease-api-builder /netease-api /netease-api
# 转换 entrypoint.sh 换行符（Windows 打包的源码可能是 CRLF）
RUN sed -i 's/\r$//' entrypoint.sh && chmod +x entrypoint.sh

# supervisor 配置：同时启动 netease-api (node) 和 bot (python)
COPY supervisord.conf /etc/supervisor/conf.d/botamusique.conf

ENTRYPOINT ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/botamusique.conf"]
